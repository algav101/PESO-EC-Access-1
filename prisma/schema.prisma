datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  passwordHash  String
  plainPassword String?   // Saved/initial plaintext password viewable by Domain Master & PESO Admin
  fullName      String
  email         String?
  role          String    @default("PESO_ADMIN") // PESO_ADMIN, TUPAD_COORDINATOR, TUPAD_ASSISTING_DOCUMENTOR, DOLE_COORDINATOR, DOMAIN_MASTER, PESO_STAFF
  status        String    @default("ACTIVE")
  assignedBarangay String? // Assigned Barangay for TUPAD_COORDINATOR (e.g. Paltic, Aplaya)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdPrograms        Program[]              @relation("ProgramCreator")
  qrPrintBatches         QrPrintBatch[]
  qrPrintLogs            QrPrintLog[]
  stubDistributions      StubDistribution[]
  orientationAttendances OrientationAttendance[]
  replacementsInitiated  BeneficiaryReplacement[] @relation("ReplacementInitiator")
  replacementsApproved   BeneficiaryReplacement[] @relation("ReplacementApprover")
  attendanceRecords      AttendanceRecord[]
  accomplishmentPhotos   AccomplishmentPhoto[]    @relation("PhotoUploader")
  approvedPhotos         AccomplishmentPhoto[]    @relation("PhotoApprover")
  payoutsVerified        Payout[]
  auditLogs              AuditLog[]
}

model Program {
  id                  String   @id @default(uuid())
  programCode         String   @unique
  batchNumber         String?
  programName         String
  municipality        String   @default("Dingalan")
  province            String   @default("Aurora")
  doleOffice          String?  @default("DOLE Aurora Field Office")
  projectLocation     String?
  natureOfWork        String?
  beneficiaryCount    Int      @default(0)
  requiredWorkDays    Int      @default(10)
  dailyHours          Float    @default(8.0)
  morningStart        String?  @default("08:00")
  morningEnd          String?  @default("12:00")
  afternoonStart      String?  @default("13:00")
  afternoonEnd        String?  @default("17:00")
  orientationDate     String?
  orientationTime     String?
  orientationVenue    String?
  payoutDate          String?
  payoutTime          String?
  payoutVenue         String?
  startDate           String?
  endDate             String?
  status              String   @default("DRAFT") // DRAFT, ACTIVE, COMPLETED, CLOSED
  createdById         String?
  createdBy           User?    @relation("ProgramCreator", fields: [createdById], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  programBarangays    ProgramBarangay[]
  programBeneficiaries ProgramBeneficiary[]
  workDays            WorkDay[]
  qrCodes             QrCode[]
  qrPrintBatches      QrPrintBatch[]
  tableRules          TableAssignmentRule[]
  orientationAttendance OrientationAttendance[]
  beneficiaryReplacements BeneficiaryReplacement[]
  attendanceRecords   AttendanceRecord[]
  accomplishmentPhotos AccomplishmentPhoto[]
  photoConfig         PhotoConfiguration?
  payouts             Payout[]
  restrictions        BeneficiaryRestriction[]
  tupadWorkPrograms   TupadWorkProgram[]

  @@index([createdById])
  @@index([status])
}

model ProgramBarangay {
  id                String   @id @default(uuid())
  programId         String
  program           Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  barangayName      String
  projectLocation   String?
  beneficiaryTarget Int      @default(0)
  createdAt         DateTime @default(now())

  @@unique([programId, barangayName])
}

model Beneficiary {
  id                String   @id @default(uuid())
  beneficiaryNumber String
  fullName          String
  lastName          String?
  firstName         String?
  middleName        String?
  extensionName     String?
  birthday          String   // YYYY-MM-DD or MM-DD-YYYY
  sex               String?  // MALE, FEMALE
  civilStatus       String?
  age               Int?
  monthlyIncome     Float?
  typeOfBeneficiary String?
  occupation        String?
  idType            String?
  idNumber          String?
  sitio             String?
  barangay          String?
  municipality      String   @default("Dingalan")
  province          String   @default("Aurora")
  contactNumber     String?
  isSenior          Boolean  @default(false)
  isPwd             Boolean  @default(false)
  is4Ps             Boolean  @default(false)
  isIp              Boolean  @default(false)
  skillsTraining    String?
  status            String   @default("ACTIVE")
  sourceImportId    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  programBeneficiaries ProgramBeneficiary[]
  dependents           Dependent[]
  documents            BeneficiaryDocument[]
  restrictions         BeneficiaryRestriction[]

  @@index([status])
  @@index([barangay])
  @@index([fullName])
}

model ProgramBeneficiary {
  id                   String      @id @default(uuid())
  programId            String
  program              Program     @relation(fields: [programId], references: [id], onDelete: Cascade)
  beneficiaryId        String
  beneficiary          Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  designatedNumber     String      // e.g. 1, 2, 3...
  participationStatus  String      @default("ACTIVE") // ACTIVE, REPLACED, WITHDRAWN, DISQUALIFIED
  originalBeneficiary  Boolean     @default(true)
  tableNumber          String?
  slotGroup            String?     // e.g. "Main", "DepEd Slot"
  joinedAt             DateTime    @default(now())

  qrCodes              QrCode[]
  stubDistributions    StubDistribution[]
  orientationAttendance OrientationAttendance[]
  originalReplacements BeneficiaryReplacement[] @relation("OriginalBeneficiary")
  newReplacements      BeneficiaryReplacement[] @relation("ReplacementBeneficiary")
  attendanceRecords    AttendanceRecord[]
  payouts              Payout[]

  @@index([programId, designatedNumber])
  @@index([programId, participationStatus])
  @@index([beneficiaryId])
  @@index([participationStatus])
}

model Dependent {
  id            String      @id @default(uuid())
  beneficiaryId String
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  firstName     String?
  middleName    String?
  lastName      String?
  extensionName String?
  fullName      String
  birthday      String?
  age           Int?
  relationship  String?
  createdAt     DateTime    @default(now())
  restrictions  BeneficiaryRestriction[]

  @@index([beneficiaryId])
}

model BeneficiaryDocument {
  id                 String      @id @default(uuid())
  beneficiaryId      String
  beneficiary        Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  documentType       String      // ID_FRONT, ID_BACK, DEPENDENT_DOC, OTHER
  fileKey            String
  fileName           String
  fileSize           Int
  mimeType           String
  uploadedById       String?
  verificationStatus String      @default("PENDING")
  uploadedAt         DateTime    @default(now())

  @@index([beneficiaryId])
  @@index([uploadedById])
}

model QrCode {
  id                   String             @id @default(uuid())
  programId            String
  program              Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  programBeneficiaryId String
  programBeneficiary   ProgramBeneficiary @relation(fields: [programBeneficiaryId], references: [id], onDelete: Cascade)
  publicToken          String             @unique
  tokenHash            String             @unique
  status               String             @default("ACTIVE") // ACTIVE, REPRINTED, REPLACED, INVALIDATED
  generatedAt          DateTime           @default(now())
  generatedById        String?
  invalidatedAt        DateTime?
  invalidatedById      String?

  printLogs            QrPrintLog[]
  stubDistributions    StubDistribution[]

  @@index([programId])
  @@index([programBeneficiaryId])
}

model QrPrintBatch {
  id              String       @id @default(uuid())
  programId       String
  program         Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  batchName       String
  paperSize       String       @default("A4") // A4, LETTER, LEGAL, CUSTOM
  stubWidth       Float        @default(90.0) // mm
  stubHeight      Float        @default(55.0) // mm
  rowsPerPage     Int          @default(4)
  columnsPerPage  Int          @default(2)
  reminderText    String?
  printedById     String?
  printedBy       User?        @relation(fields: [printedById], references: [id])
  printedAt       DateTime?
  printStatus     String       @default("PREVIEW")
  createdAt       DateTime     @default(now())

  printLogs       QrPrintLog[]

  @@index([programId])
  @@index([printedById])
}

model QrPrintLog {
  id           String        @id @default(uuid())
  qrId         String
  qr           QrCode        @relation(fields: [qrId], references: [id], onDelete: Cascade)
  printBatchId String?
  printBatch   QrPrintBatch? @relation(fields: [printBatchId], references: [id], onDelete: SetNull)
  printType    String        // INITIAL, REPRINT, REPLACEMENT, ADDITIONAL
  reason       String?
  printedById  String?
  printedBy    User?         @relation(fields: [printedById], references: [id])
  printedAt    DateTime      @default(now())

  @@index([qrId])
  @@index([printBatchId])
  @@index([printedById])
}

model TableAssignmentRule {
  id          String   @id @default(uuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  startNumber Int
  endNumber   Int
  tableNumber String
  slotGroup   String?
  priority    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([programId])
}

model StubDistribution {
  id                   String             @id @default(uuid())
  qrId                 String
  qr                   QrCode             @relation(fields: [qrId], references: [id], onDelete: Cascade)
  programBeneficiaryId String
  programBeneficiary   ProgramBeneficiary @relation(fields: [programBeneficiaryId], references: [id], onDelete: Cascade)
  distributedById      String?
  distributedBy        User?              @relation(fields: [distributedById], references: [id])
  distributedAt        DateTime           @default(now())
  verificationMethod   String             @default("BIRTHDAY_PIN")
  status               String             @default("DISTRIBUTED")
  remarks              String?
  latitude             Float?
  longitude            Float?
  deviceId             String?

  @@index([programBeneficiaryId, status])
  @@index([status])
  @@index([distributedAt])
  @@index([qrId])
  @@index([distributedById])
}

model OrientationAttendance {
  id                   String             @id @default(uuid())
  programId            String
  program              Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  programBeneficiaryId String
  programBeneficiary   ProgramBeneficiary @relation(fields: [programBeneficiaryId], references: [id], onDelete: Cascade)
  status               String             @default("PRESENT") // PRESENT, ABSENT, REPLACED
  scannedById          String?
  scannedBy            User?              @relation(fields: [scannedById], references: [id])
  scannedAt            DateTime           @default(now())
  deviceId             String?
  syncStatus           String             @default("SYNCED")

  @@unique([programId, programBeneficiaryId])
  @@index([programId, status])
  @@index([programBeneficiaryId])
  @@index([scannedById])
}

model BeneficiaryReplacement {
  id                              String             @id @default(uuid())
  programId                       String
  program                         Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  originalProgramBeneficiaryId    String
  originalProgramBeneficiary      ProgramBeneficiary @relation("OriginalBeneficiary", fields: [originalProgramBeneficiaryId], references: [id], onDelete: Cascade)
  replacementProgramBeneficiaryId String?
  replacementProgramBeneficiary   ProgramBeneficiary? @relation("ReplacementBeneficiary", fields: [replacementProgramBeneficiaryId], references: [id], onDelete: SetNull)
  reason                          String
  initiatedById                   String?
  initiatedBy                     User?              @relation("ReplacementInitiator", fields: [initiatedById], references: [id])
  approvedById                    String?
  approvedBy                      User?              @relation("ReplacementApprover", fields: [approvedById], references: [id])
  initiatedAt                     DateTime           @default(now())
  approvedAt                      DateTime?
  status                          String             @default("PENDING") // PENDING, APPROVED, REJECTED

  @@index([programId])
  @@index([originalProgramBeneficiaryId])
  @@index([replacementProgramBeneficiaryId])
  @@index([initiatedById])
  @@index([approvedById])
}

model WorkDay {
  id          String   @id @default(uuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  dayNumber   Int      // 1, 2, ... 10
  workDate    String   // YYYY-MM-DD
  description String?
  status      String   @default("SCHEDULED") // SCHEDULED, ACTIVE, COMPLETED, CANCELLED

  attendanceRecords    AttendanceRecord[]
  accomplishmentPhotos AccomplishmentPhoto[]

  @@unique([programId, dayNumber])
  @@unique([programId, workDate])
  @@index([programId])
}

model AttendanceRecord {
  id                   String             @id @default(uuid())
  programId            String
  program              Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  workDayId            String
  workDay              WorkDay            @relation(fields: [workDayId], references: [id], onDelete: Cascade)
  programBeneficiaryId String
  programBeneficiary   ProgramBeneficiary @relation(fields: [programBeneficiaryId], references: [id], onDelete: Cascade)
  attendanceDate       String             // YYYY-MM-DD
  morningTimeIn        DateTime?
  morningTimeOut       DateTime?
  afternoonTimeIn      DateTime?
  afternoonTimeOut     DateTime?
  status               String             @default("PRESENT") // PRESENT, INCOMPLETE, ABSENT
  source               String             @default("QR_SCAN")
  scannedById          String?
  scannedBy            User?              @relation(fields: [scannedById], references: [id])
  deviceId             String?
  syncStatus           String             @default("SYNCED")
  workProgramItemId    String?
  workProgramItem      TupadWorkProgramItem? @relation(fields: [workProgramItemId], references: [id], onDelete: SetNull)
  workArea             String?
  activityName         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([programId, workDayId, programBeneficiaryId])
  @@index([programId, attendanceDate])
  @@index([attendanceDate, status])
  @@index([programBeneficiaryId])
  @@index([workDayId])
  @@index([scannedById])
  @@index([workProgramItemId])
}

model AccomplishmentPhoto {
  id                String                @id @default(uuid())
  programId         String
  program           Program               @relation(fields: [programId], references: [id], onDelete: Cascade)
  workDayId         String?
  workDay           WorkDay?              @relation(fields: [workDayId], references: [id], onDelete: SetNull)
  workProgramItemId String?
  workProgramItem   TupadWorkProgramItem? @relation(fields: [workProgramItemId], references: [id], onDelete: SetNull)
  barangay          String?
  sitio             String?
  workArea          String?
  specificActivity  String?
  fileKey           String
  fileName          String
  latitude          Float?
  longitude         Float?
  capturedAt        DateTime?
  uploadedAt        DateTime              @default(now())
  uploadedById      String?
  uploadedBy        User?                 @relation("PhotoUploader", fields: [uploadedById], references: [id])
  status            String                @default("FOR_REVIEW") // FOR_REVIEW, APPROVED, REJECTED
  isExported        Boolean               @default(false)
  isPurged          Boolean               @default(false)
  approvedById      String?
  approvedBy        User?                 @relation("PhotoApprover", fields: [approvedById], references: [id])
  approvedAt        DateTime?
  rejectionReason   String?

  @@index([programId, status])
  @@index([uploadedAt])
  @@index([barangay])
  @@index([workDayId])
  @@index([workProgramItemId])
  @@index([uploadedById])
  @@index([approvedById])
}

model PhotoConfiguration {
  id               String   @id @default(uuid())
  programId        String   @unique
  program          Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  showGps          Boolean  @default(true)
  showDate         Boolean  @default(true)
  showTime         Boolean  @default(true)
  showBarangay     Boolean  @default(true)
  showProgramName  Boolean  @default(true)
  dateFormat       String   @default("MMMM DD, YYYY")
  gpsFormat        String   @default("DECIMAL")
  overlayPosition  String   @default("BOTTOM")
  updatedAt        DateTime @default(now())
}

model Payout {
  id                   String             @id @default(uuid())
  programId            String
  program              Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  programBeneficiaryId String
  programBeneficiary   ProgramBeneficiary @relation(fields: [programBeneficiaryId], references: [id], onDelete: Cascade)
  status               String             // PAID, PRESENT_NOT_PAID, ABSENT, PENDING
  payoutDate           String?            // YYYY-MM-DD
  verifiedAt           DateTime?
  verifiedById         String?
  verifiedBy           User?              @relation(fields: [verifiedById], references: [id])
  remarks              String?
  createdAt            DateTime           @default(now())

  @@unique([programId, programBeneficiaryId])
  @@index([programId, status])
  @@index([status])
  @@index([programBeneficiaryId])
  @@index([verifiedById])
}

model BeneficiaryRestriction {
  id               String       @id @default(uuid())
  beneficiaryId    String?
  beneficiary      Beneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  dependentId      String?
  dependent        Dependent?   @relation(fields: [dependentId], references: [id], onDelete: SetNull)
  sourceProgramId  String?
  sourceProgram    Program?     @relation(fields: [sourceProgramId], references: [id], onDelete: SetNull)
  payoutDate       String       // YYYY-MM-DD or formatted date
  restrictionStart String?      // YYYY-MM-DD
  restrictionEnd   String?      // YYYY-MM-DD (+320/365 days)
  adlNo            String?      // ADL No. or Barangay Appointive Position (e.g. 2025_03_0318_RO3_LAWAATBINHI, BHW, Tanod)
  workDate         String?      // Work duration date (e.g. Aug. 4-Sept. 5, 2025)
  orientationDate  String?      // Orientation date (e.g. July 22, 2025)
  barangay         String?      // Barangay (e.g. BUHANGIN, Paltic)
  municipality     String?      // City/Municipality (e.g. BALER, Dingalan)
  isAppointivePersonnel Boolean @default(false)
  reason           String       @default("320-day TUPAD payout restriction")
  status           String       @default("ACTIVE") // ACTIVE, OVERRIDDEN, EXPIRED
  createdAt        DateTime     @default(now())

  @@index([status])
  @@index([beneficiaryId])
  @@index([dependentId])
  @@index([sourceProgramId])
  @@index([payoutDate])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  oldData    String?  // JSON string
  newData    String?  // JSON string
  metadata   String?  // JSON string
  ipAddress  String?
  deviceId   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @default(now())
}

model TupadWorkProgram {
  id               String                 @id @default(uuid())
  programId        String
  program          Program                @relation(fields: [programId], references: [id], onDelete: Cascade)
  barangay         String
  projectLocation  String?
  beneficiaryCount Int                    @default(0)
  natureOfWork     String?
  workingHours     String?                @default("Not Exceed Eight (8) Hours a day (8:00 AM–12:00 NN; 1:00 PM–5:00 PM)")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  items            TupadWorkProgramItem[]

  @@unique([programId, barangay])
  @@index([programId])
}

model TupadWorkProgramItem {
  id                  String                 @id @default(uuid())
  workProgramId       String
  workProgram         TupadWorkProgram       @relation(fields: [workProgramId], references: [id], onDelete: Cascade)
  dayNumber           Int                    // 1 to 10
  specificActivities  String
  area                String                 // e.g. "Purok Mulawin to Ipil-ipil"
  maleCount           Int                    @default(0)
  femaleCount         Int                    @default(0)
  scPwdMaleCount      Int                    @default(0)
  scPwdFemaleCount    Int                    @default(0)
  totalCount          Int                    @default(0)
  orderIndex          Int                    @default(0)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  attendanceRecords   AttendanceRecord[]
  accomplishmentPhotos AccomplishmentPhoto[]

  @@index([workProgramId])
}

model TupadApplicationRoster {
  id                    String   @id @default(uuid())
  batchName             String?  @default("TUPAD Applicant Masterlist")
  lastName              String
  firstName             String
  middleName            String?
  extensionName         String?
  fullName              String   // Standard normalized: "LAST, FIRST MIDDLE EXT"
  birthMonth            String?
  birthDay              String?
  birthYear             String?
  birthday              String?  // Formatted MM-DD-YYYY or YYYY-MM-DD
  civilStatus           String?
  streetSitio           String?
  barangay              String?
  contactNumber         String?
  idPresented           String?
  idNumber              String?
  is4ps                 String?  // "Y", "N", "YES", "NO"
  isIp                  String?  // "Y", "N", "YES", "NO"
  occupation            String?
  monthlyIncome         String?
  dependentFullName     String?
  dependentAge          String?
  dependentRelationship String?
  remarks               String?
  status                String   @default("QUEUED") // QUEUED, INCOMPLETE, APPROVED, DISQUALIFIED
  uploadedById          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([fullName])
  @@index([lastName, firstName])
  @@index([barangay])
}

model PublicInquiryMessage {
  id             String    @id @default(uuid())
  trackingCode   String    @unique
  category       String    @default("INQUIRY") // INQUIRY, SUGGESTION, COMMENT, APPLICATION_FOLLOWUP
  subject        String?
  message        String
  isAnonymous    Boolean   @default(false)
  senderName     String
  senderContact  String
  senderBarangay String?
  status         String    @default("UNREAD") // UNREAD, REVIEWED, REPLIED, RESOLVED, ARCHIVED
  adminRemarks   String?
  adminReply     String?
  repliedAt      DateTime?
  repliedById    String?
  ipAddress      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([trackingCode])
  @@index([createdAt])
}


// ============================================================================
// MODULE 5: MIGRANTS' CORNER (OFW & SEAFARER HELPDESK)
// ============================================================================

model MigrantCaseReport {
  id                    String               @id @default(uuid())
  trackingCode          String               @unique
  workerCategory        String               @default("LAND_BASED") // LAND_BASED, SEA_BASED
  caseCategory          String               @default("CONTRACT_VIOLATION_UNPAID_WAGES")
  urgencyLevel          String               @default("HIGH") // NORMAL, HIGH, CRITICAL_SOS
  ofwLastName           String
  ofwFirstName          String
  ofwMiddleName         String?
  ofwSuffix             String?
  ofwFullName           String
  ofwBirthday           String?
  ofwSex                String?
  ofwCivilStatus        String?
  ofwContactAbroad      String
  passportNumber        String?
  sirbNumber            String?              // Seafarer's Identification & Record Book (Seaman's Book)
  owwaStatus            String               @default("ACTIVE") // ACTIVE, INACTIVE, NON_MEMBER, UNDOCUMENTED
  countryOrVessel       String               // Host Country or Vessel Name & Flag
  jobPosition           String
  foreignEmployer       String?
  localAgency           String?              // DMW Licensed Recruitment / Manning Agency
  isFiledByFamily       Boolean              @default(false)
  reporterName          String
  reporterRelationship  String               @default("SELF")
  reporterBarangay      String?
  reporterContact       String
  caseSummary           String               // Detailed Salaysay / Narrative
  submittedRequirements String?              // JSON string of OWWA/DMW documentary requirements & attachments
  status                String               @default("OPEN") // OPEN, UNDER_INVESTIGATION, ENDORSED_TO_DMW_OWWA, RESOLVED, CLOSED
  endorsedAgency        String?              // e.g. DMW RO-III, OWWA RWO-III, MWO/Embassy, MARINA/NLRC
  adminRemarks          String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  messages              MigrantCaseMessage[]

  @@index([trackingCode])
  @@index([status])
  @@index([workerCategory])
  @@index([urgencyLevel])
  @@index([createdAt])
}

model MigrantCaseMessage {
  id             String            @id @default(uuid())
  caseId         String
  caseReport     MigrantCaseReport @relation(fields: [caseId], references: [id], onDelete: Cascade)
  senderType     String            @default("REPORTER") // REPORTER, PESO_STAFF, DMW_OWWA_DESK
  senderName     String
  message        String
  attachmentName String?
  attachmentUrl  String?
  createdAt      DateTime          @default(now())

  @@index([caseId])
  @@index([createdAt])
}

model BalikPinasApplication {
  id                       String   @id @default(uuid())
  controlNo                String   @unique
  programComponent         String   @default("EBPBH") // EBPBH (Enhanced Balik Pinay Balik Hanapbuhay), ELDAP (Expanded Livelihood Dev Assistance)
  dateFiled                String
  scheduledBy              String?
  photoDataUrl             String?  // 2x2 ID Picture (base64 data URL)

  // I. DATOS TUNGKOL SA OFW (ELPOR Form A)
  lastName                 String
  firstName                String
  middleName               String?
  suffix                   String?
  fullName                 String
  houseNumber              String?
  street                   String?
  barangay                 String
  municipality             String   @default("Dingalan")
  province                 String   @default("Aurora")
  birthdate                String
  age                      Int?
  sex                      String   @default("FEMALE") // MALE, FEMALE
  civilStatus              String   @default("MARRIED") // SINGLE, MARRIED, SEPARATED, WIDOWED
  otherDataJson            String?  // JSON: { isPwd, isSenior, isSoloParent, isIp, isLgbtqia }
  cellphone1               String
  cellphone2               String?
  emailOrFb                String?
  workerCategory           String   @default("LAND_BASED") // SEA_BASED, LAND_BASED

  // II. DATOS TUNGKOL SA OFW EMPLOYMENT (ELPOR Form A & A2)
  jobsiteCountry           String
  jobPosition              String
  latestDepartureDate      String?
  latestContractDuration   String?
  latestArrivalDate        String?
  passportNumber           String?

  // III. DATOS TUNGKOL SA NEGOSYO (ELPOR Form A)
  proposedBusinessType     String
  businessLocation         String
  hasExistingBusiness      Boolean  @default(false)
  existingBusinessDetails  String?

  // IV. MGA PAGSASANAY SA NEGOSYO (ELPOR Form A)
  trainingKind             String?
  trainingVenue            String?
  trainingIssuedBy         String?
  trainingDate             String?

  // ELPOR FORM A2: OFW STATEMENT FORM
  reasonForReturn          String
  briefStatement           String

  // ELPOR FORM B1: LISTAHAN NG PANIMULANG KAGAMITAN AT PRODUKTO
  suppliesAndEquipmentJson String?  // JSON array of PRODUKTO & KAGAMITAN items
  totalProposedAmount      Float    @default(20000)

  // ELPOR FORM B: BUSINESS MODEL CANVAS
  businessCanvasJson       String?  // JSON object of 1. Business Idea, 2. Marketing, 3. Operations, 4. Finance

  // ELPOR FORM C (COMMITMENT) & KASULATAN & DOCUMENTS CHECKLIST
  documentsChecklistJson   String?  // JSON checklist of Form A, A2, B, B1, C, Passport, Arrival Proof, Training Cert
  agreedToCommitment       Boolean  @default(true)
  agreedToKasulatan        Boolean  @default(true)

  // STAFF / DMW RO III EVALUATION
  status                   String   @default("SUBMITTED") // SUBMITTED, UNDER_EVALUATION, ENDORSED_TO_DMW_RO3, APPROVED, RELEASED, DISAPPROVED
  withPreviousAvailment    Boolean  @default(false)
  previousProgram          String?
  amountOfAssistance       Float?   @default(20000)
  evaluatedBy              String?
  adminRemarks             String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([controlNo])
  @@index([status])
  @@index([barangay])
  @@index([programComponent])
  @@index([createdAt])
}

model OfwFamilyCircleMember {
  id                    String   @id @default(uuid())
  memberCode            String   @unique
  photoDataUrl          String?  // Uploaded photo of OFW or Family Circle Member

  // Left Column of OFW Information Sheet
  ofwLastName           String
  ofwFirstName          String
  ofwMiddleName         String?
  ofwSuffix             String?
  ofwFullName           String
  ofwSex                String   @default("FEMALE")
  ofwBirthdate          String
  ofwContactInfo        String
  abroadResidencyStatus String   @default("CONTRACTUAL") // PERMANENTE, PETITIONER, UNDOCUMENTED

  // Right Column of OFW Information Sheet
  occupationAbroad      String
  monthlyIncome         String?
  countryOfWork         String
  agencyName            String?
  employmentStatus      String   @default("CONTRACTUAL") // PERMANENTE, CONTRACTUAL, UNDOCUMENTED
  contractDuration      String?

  // Bottom Section: Detalye ng pamilya na sa Dingalan naninirahan
  dingalanBarangay      String
  dingalanPurokSitio    String?
  familyContactInfo     String
  familyMembersJson     String   // JSON array of { fullName, relationship, birthdate, sex, education, skills }
  representativeName    String   // Pangalan at Lagda ng Kinatawan ng OFW

  membershipStatus      String   @default("ACTIVE") // ACTIVE, VERIFIED, RETURNING_OFW, ARCHIVED
  remarks               String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([memberCode])
  @@index([ofwFullName])
  @@index([dingalanBarangay])
  @@index([membershipStatus])
  @@index([createdAt])
}
